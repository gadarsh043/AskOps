# Copy to .env and fill in all values.
# Generate secrets with: openssl rand -hex 32

# Postgres superuser (used only by Docker init scripts and healthcheck)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=            # openssl rand -hex 32

# App role password (used by n8n credential and psql.sh)
APP_DB_PASSWORD=              # openssl rand -hex 32

# n8n encryption key — keep this stable or n8n loses all stored credentials
N8N_ENCRYPTION_KEY=           # openssl rand -hex 32

# Optional: pin n8n to match your Railway version (e.g. 1.97.1)
# N8N_VERSION=1.97.1

# Public base URL for approval-email links (run scripts/tunnel.sh to get one)
WEBHOOK_URL=https://xxxx.trycloudflare.com

# Timezone
TZ=America/New_York

# --- API keys (you fill in) ---
GROQ_API_KEY=
GEMINI_API_KEY=

# --- n8n REST API (used by export-workflows.sh and import-workflows.sh) ---
# URL of your running n8n instance
N8N_API_URL=http://localhost:5678
# Create in n8n UI: Settings → n8n API → Create key
N8N_API_KEY=
