        "responseMode": "lastNode",
        "options": {
          "allowedOrigins": "*"
        }
      },
      "webhookId": "wh2"
    },
    {
      "id": "pg2a",
      "name": "Get Employee",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        220,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "4DuuvBbohpSo7Mr0",
          "name": "AskOps Postgres"
        }
      },
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, workspace_id, full_name, access_role, title, employee_code, department\n                 FROM employees\n                 WHERE employee_code = '{{ $json.body.employee_code }}'\n                   AND workspace_id = '{{ $json.body.workspace_id }}'::uuid\n                 LIMIT 1",
        "options": {}
      }
    },
    {
      "id": "pg2b",
      "name": "Set Session",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        440,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "4DuuvBbohpSo7Mr0",
          "name": "AskOps Postgres"
        }
      },
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT set_active_session(\n                   '{{ $json.workspace_id }}'::uuid,\n                   '{{ $json.id }}'::uuid\n                 ) AS ok",
        "options": {}
      }
    },
    {
      "id": "pg2c",
      "name": "Update Manager Email",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        660,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "4DuuvBbohpSo7Mr0",
          "name": "AskOps Postgres"
        }
      },
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE workspaces\n                 SET demo_manager_email = '{{ $(\"Webhook\").first().json.body.manager_email }}'\n                 WHERE id = '{{ $(\"Webhook\").first().json.body.workspace_id }}'::uuid\n                   AND '{{ $(\"Webhook\").first().json.body.manager_email }}' != ''\n                 RETURNING id",
        "options": {}
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "fmt2",
      "name": "Format",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "jsCode": "const emp = $('Get Employee').first().json;\nreturn [{ json: {\n  status: 'ok',\n  employee_code: emp.employee_code,\n  full_name: emp.full_name,\n  access_role: emp.access_role,\n  title: emp.title,\n  department: emp.department\n} }];"
      }
    }
