  "nodes": [
    {
      "id": "wh1",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "path": "api-build-status",
        "httpMethod": "GET",
        "responseMode": "lastNode",
        "options": {
          "allowedOrigins": "*"
        }
      },
      "webhookId": "wh1"
    },
    {
      "id": "pg1",
      "name": "Get Build Events",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        220,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "4DuuvBbohpSo7Mr0",
          "name": "AskOps Postgres"
        }
      },
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT COALESCE(\n                   json_agg(\n                     json_build_object(\n                       'step', e.step,\n                       'status', e.status,\n                       'message', e.message,\n                       'progress', e.progress,\n                       'created_at', TO_CHAR(e.created_at,'YYYY-MM-DD\"T\"HH24:MI:SS\"Z\"')\n                     ) ORDER BY e.id ASC\n                   ),\n                   '[]'::json\n                 ) AS events\n                 FROM build_events e\n                 WHERE e.workspace_id = '{{ $json.query.workspace_id }}'::uuid",
        "options": {}
      }
    },
    {
      "id": "fmt1",
      "name": "Format",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "jsCode": "const d = $input.first().json;\nconst events = d.events || [];\nreturn [{ json: { events: events, count: events.length } }];"
      }
    }
  ],
